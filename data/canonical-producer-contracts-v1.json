{
  "schema": "thc-canonical-producer-contracts",
  "version": 1,
  "purpose": "Machine-readable migration and validation state for stateful cultivation-tool canonical record producers.",
  "statuses": [
    "planned",
    "implemented"
  ],
  "rules": [
    "implemented producers must load the canonical cultivation-data UI runtime and emit their declared collector/toolId",
    "producerPath may identify a deployed subroute or module when the canonical producer does not live in the tool route root",
    "measurement and observation producers represent user-observed data; configuration and planning values must not be mislabeled as observations",
    "derived outputs must retain derived provenance when emitted through tool-result workflows",
    "planned contracts document migration intent without making CI claim the producer is implemented"
  ],
  "producers": [
    {
      "toolId": "ph-meter",
      "producerMode": "measurement",
      "status": "implemented",
