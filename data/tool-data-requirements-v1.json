{
  "schema": "thc-tool-data-requirements",
  "version": 1,
  "purpose": "Canonical map of cultivation data that DTF tools collect, consume, derive, and share.",
  "sharedRecordSchema": "thc-cultivation-record@1",
  "rules": [
    "Tools should consume canonical metric names and units rather than inventing local aliases.",
    "A tool may keep UI-specific fields, but reusable measurements/results should also be emitted as canonical cultivation records.",
    "Sensor/provider data, manual readings, GrowLens records, and calculated tool outputs use the same record envelope.",
    "Derived values must set provenance.derived=true; estimates must set provenance.estimated=true.",
    "Private notes, account credentials, contact details, and image bytes are not part of the shared tool-data contract."
  ],
  "metrics": {
    "environment": [
      "temperatureC",
      "leafTemperatureC",
      "humidityPercent",
      "vpdKpa",
      "dewPointC",
      "co2Ppm"
    ],
    "light": [
      "ppfdUmolM2S",
      "dliMolM2Day"
    ],
    "solution": [
      "ph",
      "ecMsCm",
      "ppm",
      "ppmScale",
      "solutionTemperatureC",
      "volumeMl"
    ],
    "irrigation": [
      "volumeMl",
      "runoffMl",
      "runoffPercent",
      "drybackPercent",
      "inputPh",
      "runoffPh",
      "inputEcMsCm",
      "runoffEcMsCm",
      "irrigationDurationMinutes",
      "substrateVolumeMl",
      "runoffEcDeltaMsCm"
    ],
    "rootZone": [
      "rootTemperatureC",
      "vwcPercent",
      "ecMsCm",
      "ph",
      "drybackPercent"
    ],
    "plantGrowth": [
      "heightCm",
      "widthCm",
      "stemDiameterMm",
      "leafCount",
      "nodeCount",
      "internodeLengthCm",
      "branchCount",
      "flowerDays"
    ],
    "harvest": [
      "wetWeightG",
      "dryWeightG",
      "trimmedWeightG",
      "wasteWeightG",
      "dryingDays"
    ],
    "dryCure": [
      "temperatureC",
      "humidityPercent",
      "waterActivity"
    ],
    "observation": {
      "structuredValues": [
        "symptoms",
        "possibleCauses",
        "verifiedCause",
        "actionTaken",
        "outcomeStatus",
        "severity",
        "locationOnPlant",
        "tissue",
        "pestOrPathogen",
        "trainingType",
        "sampleContext",
        "sourceWater",
        "substrate",
        "medium",
        "cultivarTrait"
      ],
      "links": [
        "observationId",
        "parentRecordId",
        "mediaRefs"
      ],
      "note": "Arrays and categorical values are supported in record.values; mediaRefs link private or approved assets without embedding image bytes."
    },
    "waterQuality": [
      "ph",
      "ecMsCm",
      "solutionTemperatureC",
      "alkalinityMgLAsCaCO3",
      "hardnessMgLAsCaCO3",
      "calciumMgL",
      "magnesiumMgL",
      "sodiumMgL",
      "chlorideMgL",
      "nitrogenMgL",
      "nitrateNitrogenMgL",
      "phosphorusMgL",
      "potassiumMgL",
      "sulfurMgL",
      "sulfateSulfurMgL",
      "ironMgL",
      "manganeseMgL",
      "zincMgL",
      "copperMgL",
      "boronMgL",
      "molybdenumMgL"
    ],
    "ventilation": [
      "roomVolumeFt3",
      "airflowCfm",
      "airChangesPerHour",
      "requiredAirflowCfm",
      "co2Ppm"
    ],
    "photoperiod": [
      "photoperiodHours",
      "dliMolM2Day"
    ],
    "substrate": [
      "substrateVolumeL",
      "containerVolumeL",
      "vwcPercent",
      "rootTemperatureC",
      "ecMsCm",
      "ph"
    ],
    "breeding": [
      "populationCount",
      "selectedPlantCount"
    ],
    "calculation": [
      "dilutionVolumeMl",
      "concentrationPercent"
    ]
  },
  "tools": [
    {
      "id": "vpd",
      "route": "/vpd-chart/",
      "recordTypes": [
        "environment",
        "tool-result"
      ],
      "requires": [
        "temperatureC",
        "humidityPercent"
      ],
      "optional": [
        "leafTemperatureC"
      ],
      "derives": [
        "vpdKpa"
      ],
      "collects": [
        "temperatureC",
        "humidityPercent",
        "leafTemperatureC",
        "vpdKpa"
      ],
      "dataMode": "stateful"
    },
    {
